<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:clipChildren="false" android:clipToPadding="false"
    android:paddingBottom="16dp">
    <FrameLayout android:layout_width="match_parent" android:layout_height="120dp">
        <LinearLayout android:id="@+id/controls_card" android:visibility="gone"
            android:layout_width="match_parent" android:layout_height="wrap_content">
            <ImageView android:id="@+id/image" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <FrameLayout android:id="@+id/description_dock" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/thumbs_row_wrapper" android:visibility="invisible"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_gravity="bottom" android:orientation="vertical">
            <com.liskovsoft.smartyoutubetv2.tv.ui.mod.leanback.playerglue.seekpreview.ThumbsBar
                android:id="@+id/thumbs_row" android:orientation="horizontal"
                android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <TextView android:id="@+id/thumbs_row_title" android:visibility="gone"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal" style="?attr/playbackControlsTimeStyle"/>
        </LinearLayout>
    </FrameLayout>
    <com.liskovsoft.smartyoutubetv2.tv.ui.mod.leanback.playerglue.tweaks.PlaybackTransportRowView
        android:id="@+id/transport_row" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingStart="48dp" android:paddingEnd="48dp"
        android:clipChildren="false" android:clipToPadding="false">
        <LinearLayout android:id="@+id/top_edge" android:layout_width="match_parent" android:layout_height="1dp" android:focusable="true"/>
        <RelativeLayout android:id="@+id/time_info" android:layout_width="match_parent" android:layout_height="wrap_content" android:layoutDirection="ltr">
            <TextView android:id="@+id/current_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentStart="true" style="?attr/playbackControlsTimeStyle"/>
            <TextView android:id="@+id/total_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" style="?attr/playbackControlsTimeStyle"/>
            <TextView android:id="@+id/ending_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerHorizontal="true" android:visibility="gone" style="?attr/playbackControlsTimeStyle"/>
        </RelativeLayout>
        <com.liskovsoft.smartyoutubetv2.tv.ui.mod.leanback.misc.SeekBar android:id="@+id/playback_progress"
            android:layout_width="match_parent" android:layout_height="24dp" android:focusable="true" android:focusableInTouchMode="true"/>
        <RelativeLayout android:id="@+id/filtertv_action_row" android:layout_width="match_parent" android:layout_height="wrap_content" android:layoutDirection="ltr">
            <FrameLayout android:id="@+id/controls_dock" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerHorizontal="true"/>
            <FrameLayout android:id="@+id/secondary_controls_dock" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true"/>
        </RelativeLayout>
        <LinearLayout android:id="@+id/additional_info" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="end">
            <TextView android:id="@+id/quality_info" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone" style="?attr/playbackControlsTimeStyle"/>
            <com.liskovsoft.smartyoutubetv2.tv.ui.widgets.time.DateTimeView android:id="@+id/date_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:visibility="gone" style="?attr/playbackControlsTimeStyle"/>
        </LinearLayout>
    </com.liskovsoft.smartyoutubetv2.tv.ui.mod.leanback.playerglue.tweaks.PlaybackTransportRowView>
</LinearLayout>
